# AutoClip environment variable example
# Copy this file to .env and enter your configuration

# Database configuration
DATABASE_URL=sqlite:///./data/autoclip.db

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Backend error monitoring (optional; leave empty to disable reporting). Start with uvicorn --env-file .env.
SENTRY_DSN=

# API configuration
# Configure the desktop app in Settings; use the environment variables below for Docker / script mode, which has no Settings page.
# LLM_PROVIDER: dashscope | openai | gemini | deepseek | seed | kimi | glm | grok | infistar | api88 | apimart | ollama | lmstudio
# (A provider saved in settings.json takes precedence.)
LLM_PROVIDER=dashscope
API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
# API_OPENAI_API_KEY=
# API_GEMINI_API_KEY=
# API_DEEPSEEK_API_KEY=
# API_SEED_API_KEY=   # or ARK_API_KEY
# API_KIMI_API_KEY=
# API_GLM_API_KEY=
# API_GROK_API_KEY=
# API_INFISTAR_API_KEY=
# API_API88_API_KEY=  # or API88_API_KEY
# API_APIMART_API_KEY=  # or APIMART_API_KEY. Base URL https://api.apimart.ai/v1 is preset.
# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai; leave empty to use OpenAI's official endpoint).
# Zhipu: https://open.bigmodel.cn/api/paas/v4   DeepSeek: https://api.deepseek.com/v1
# Seed / Volcengine Ark: https://ark.cn-beijing.volces.com/api/v3
# Ollama: http://localhost:11434/v1 (inside Docker, use http://host.docker.internal:11434/v1 to access the host)
# OPENAI_BASE_URL=
# For a Qwen international-site key issued by alibabacloud.com, enter the endpoint below; leave it empty for a China-site key.
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
API_MODEL_NAME=qwen-plus
API_MAX_TOKENS=4096
API_TIMEOUT=30

# Processing configuration
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3

# Path configuration (optional; detected automatically)
# PATH_PROJECT_ROOT=
# PATH_DATA_DIR=
# PATH_UPLOADS_DIR=
# PATH_TEMP_DIR=
# PATH_OUTPUT_DIR=

# YouTube download (optional)
# Comma-separated subtitle languages; requesting too many at once can trigger 429. Default: zh-Hans,zh,en
# AUTOCLIP_YT_SUBTITLE_LANGS=zh-Hans,zh,en
# Fallback player client (android/ios/tv), used only when the default client cannot retrieve formats
# AUTOCLIP_YT_CLIENT=

# Publish to social platforms (optional): use Upload-Post to publish videos to TikTok / Instagram / YouTube Shorts / X, etc.
# Create a key at https://app.upload-post.com/api-keys; create a profile in Manage Users and connect an account.
# Alternatively, configure it with PUT /api/v1/publish/upload-post/config or `autoclip publish --api-key … --user … --save`.
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_USER=

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# Environment configuration
ENVIRONMENT=development
DEBUG=true

# Comma-separated frontend origins allowed to access the backend. localhost:3000 and the desktop app are allowed by default;
# add an entry when opening the frontend from a LAN IP or custom domain, for example http://192.168.1.20:3000
AUTOCLIP_ALLOWED_ORIGINS=
