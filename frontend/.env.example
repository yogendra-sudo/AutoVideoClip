# PostHog product analytics and event tracking
# Copy this file to .env.local and enter your PostHog project API key (.env.local is gitignored).
# Tracking is disabled automatically when no key is configured; no network requests are sent.

# Public PostHog project API key; safe to include in the frontend bundle.
VITE_PUBLIC_POSTHOG_KEY=

# PostHog host: use https://us.i.posthog.com for US or https://eu.i.posthog.com for EU.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public Sentry client DSN for crash reporting; reporting is disabled when unset.
VITE_PUBLIC_SENTRY_DSN=
